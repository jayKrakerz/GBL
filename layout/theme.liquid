<!doctype html>
<html class="no-js " lang="{{ shop.locale }}">
  <head>
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge,chrome=1">
    <meta name="viewport" content="width=device-width,initial-scale=1, maximum-scale=1">
    <meta name="theme-color" content="{{ settings.color_header_bg }}">
    <meta name="format-detection" content="telephone=no">
    <link rel="canonical" href="{{ canonical_url }}">
    <link rel="dns-prefetch" href="https://{{shop.domain }}" crossorigin>
    <link rel="dns-prefetch" href="https://{{shop.permanent_domain }}" crossorigin>
    <link rel="dns-prefetch" href="https://cdn.shopify.com" crossorigin>
    <link rel="dns-prefetch" href="https://fonts.shopifycdn.com" crossorigin>
  	<link rel="preconnect" href="https//fonts.shopifycdn.com/" crossorigin>
    <link rel="preconnect" href="https//cdn.shopify.com" crossorigin>
    
    <link rel="preconnect" href="https://fonts.shopifycdn.com" crossorigin>
    {%- unless settings.font_family.system? -%}
    <link rel="preload" as="font" href="{{ settings.font_family | font_url }}" type="font/woff2" crossorigin>
    <link rel="preload" as="font" href="{{ settings.font_family | font_url: 'woff' }}" type="font/woff" crossorigin>
  {%- endunless -%}
  {%- if settings.font_family2.system? == false and settings.font_family2 != settings.font_family -%}
    <link rel="preload" as="font" href="{{ settings.font_family2 | font_url }}" type="font/woff2" crossorigin>
    <link rel="preload" as="font" href="{{ settings.font_family2 | font_url: 'woff' }}" type="font/woff" crossorigin>
  {%- endif -%}
    {%- if settings.favicon != blank -%}
      <link rel="shortcut icon" href="{{ settings.favicon | image_url: width: 32, height: 32 }}" type="image/png">
    {%- endif -%}

    <title>
      {% if product %}
        {{ product.title }} – Premium Non-Tarnish Gold-Plated Jewelry | GBL Accessories UK
      {% elsif collection %}
        {{ collection.title }} – Shop High-Quality Gold Jewelry | GBL Accessories
      {% elsif blog %}
        {{ blog.title }} – Elegant & Durable Gold-Plated Insights | GBL Accessories
      {% elsif article %}
        {{ article.title }} – Discover Gold Jewelry Trends | GBL Accessories UK
      {% else %}
        {{ page_title }} – Luxury Non-Tarnish Jewelry | GBL Accessories
      {% endif %}

      {% if current_tags %}
        {% assign meta_tags = current_tags | join: ', ' %}
        – {{ 'general.meta.tags' | t: tags: meta_tags }}
      {% endif %}

      {% if current_page != 1 %}
        – {{ 'general.meta.page' | t: page: current_page }}
      {% endif %}
    </title>

    {% if product %}
      <meta name="description" content="Discover {{ product.title }} at GBL Accessories – high-quality, non-tarnish gold-plated jewelry perfect for any occasion. Shop now!">
    {% elsif collection %}
      <meta name="description" content="Explore our {{ collection.title }} collection – elegant, non-tarnish gold-plated jewelry designed for durability and style.">
    {% elsif blog %}
      <meta name="description" content="{{ blog.title }} – Stay inspired with the latest jewelry stories, styling tips, and gold trends from GBL Accessories.">
    {% elsif article %}
      <meta name="description" content="{{ article.excerpt | strip_html | truncate: 160 }}">
    {% else %}
      <meta name="description" content="GBL Accessories is your trusted UK store for high-quality, non-tarnish gold-plated jewelry. Elegant, durable, and affordable – shop now.">
    {% endif %}

    
    {%- render 'social-meta-tags' -%}
    {%- render 'header-css' -%}
      <link rel="preload" href="{{ 'lazysizes.min.js' | asset_url }}" as="script">
      <link rel="preload" href="{{ 'vendor.js' | asset_url }}" as="script">
      <link rel="preload" href="{{ 'swiper-bundle.min.js' | asset_url }}" as="script">
      <script src="{{ 'global.js' | asset_url }}" defer="defer"></script>
    {{ content_for_header }}

    <!-- Google Tag Manager -->
    <script>(function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':
      new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],
      j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src=
      'https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);
      })(window,document,'script','dataLayer','GTM-P8GXVGJ7');</script>
    <!-- End Google Tag Manager -->

    <!-- Google tag (gtag.js) -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-82KW8S6211"></script>
    <script>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());

      gtag('config', 'G-82KW8S6211');
    </script>
  </head>
  <body class="template-{{ template | replace: '.', ' ' | truncatewords: 1, '' | handle }} body-theme {% if settings.productpage == 'product-2' or settings.productpage == 'product-6' or settings.productpage == 'product-7' %} product-hide-breadcrumb {% endif %}">
   {% assign lazy = false %}
    <img {% if lazy %} loading = "lazy" {% endif %} width="99998" height="99999" alt="index" style="pointer-events: none; position: absolute; top: 0; left: 0; width: 99vw; height: 99vh; max-width: 99vw; max-height: 99vh;" src="data:image/svg+xml;base64,">
    {%- render 'loading' -%}
    {%- sections 'header-group' -%}
    <div class="page-container page-element is-moved-by-drawer">
      {%- render 'breadcrumb' -%}
      <main class="main-content" id="MainContent" role="main">
        {%- if settings.enable_animationscroll -%}
          <div id="js-scroll">
          {% endif %}
          {%- if settings.enable_animationscroll -%}
            <div data-scroll-section>
            {% endif %}
            {%- render 'slideshow' -%}
            {%- if settings.enable_animationscroll -%}
            </div>
          {% endif %}
          {{ content_for_layout }}
          {%- if settings.enable_animationscroll -%}
          </div>
        {% endif %}
      </main>
    {%- sections 'footer-group' -%}
     {%- liquid
      section 'pnewsletter'
      section 'product-suggest'
      section 'cookie-policy'
      section 'custom-color'
     -%}
    </div>
    {%- liquid
      render 'back-to-top' 
      render 'whatsapp'
      render 'menu-mobile' 
      render 'bottom-contents' 
      render 'quickview' 
      render 'popup-compare' 
      render 'header-js' 
    -%}

    <!-- Google Tag Manager (noscript) -->
    <noscript><iframe src="https://www.googletagmanager.com/ns.html?id=GTM-P8GXVGJ7"
    height="0" width="0" style="display:none;visibility:hidden"></iframe></noscript>
    <!-- End Google Tag Manager (noscript) -->
   
  </body>
</html>